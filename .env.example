# SponsorAJobs — Environment Configuration Template
# Copy this file to .env.local and fill in your values

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin Auth Secret ────────────────────────────────────────────────────────
ADMIN_SECRET=change-me-to-a-secure-random-secret

# ─── Free Sources (No API key required — Active by default) ──────────────────
# Arbeitnow: visa_sponsorship:true jobs — highest precision, completely free
ENABLE_ARBEITNOW=true

# Remotive: Remote tech & engineering jobs — completely free, no registration
ENABLE_REMOTIVE=true

# ─── Jooble API (Free tier — 500 requests/day) ────────────────────────────────
# Get your free key at: https://jooble.org/api/
ENABLE_JOOBLE=false
JOOBLE_API_KEY=

# ─── USAJobs Federal API (Free, register at developer.usajobs.gov) ───────────
ENABLE_USAJOBS=false
USAJOBS_EMAIL=
USAJOBS_API_KEY=

# ─── Adzuna Jobs API (Free dev tier at developer.adzuna.com) ─────────────────
ENABLE_ADZUNA=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_ATS=false
ENABLE_SAVED_JOBS=false
ENABLE_EMPLOYER_POSTING=false

# ─── Local SQLite Database ────────────────────────────────────────────────────
SQLITE_DB_PATH=./local.sqlite
