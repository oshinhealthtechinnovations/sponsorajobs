# Environment Configuration Template for SponsorAJobs
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Auth Secret (protecting /admin and /api/admin endpoints)
ADMIN_SECRET=change-me-to-a-secure-random-secret

# External Job Sources (Disabled by default per policy)
ENABLE_USAJOBS=false
USAJOBS_EMAIL=
USAJOBS_API_KEY=

ENABLE_ADZUNA=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

ENABLE_ATS=false
ENABLE_SAVED_JOBS=false
ENABLE_EMPLOYER_POSTING=false

# Local Database Configuration
SQLITE_DB_PATH=./.local-db.sqlite
