{
  "framework": "nextjs",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/auto-harvest",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/harvest-construction",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/daily-jobs-report",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/seo-automation",
      "schedule": "0 3 * * *"
    }
  ]
}
